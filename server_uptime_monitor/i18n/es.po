#. module: server_uptime_monitor
#: model:mail.template,body_html:server_uptime_monitor.email_monitor_template
msgid "<div>\n                    <h2><b>Warning!</b></h2>\n                    <p>Your server seems to be having problems. You need to check it.</p>\n                    <p>Check out your server here: <a t-att-href=\"object.url\"><t t-out=\"object.url\"/></a></p>\n                    <p>More information below</p>\n                    <style>\n                    .table_component {\n                        overflow: auto;\n                        width: 100%;\n                    }\n\n                    .table_component table {\n                        border: 1px solid #dededf;\n                        height: 100%;\n                        width: 100%;\n                        table-layout: fixed;\n                        border-collapse: collapse;\n                        border-spacing: 1px;\n                        text-align: left;\n                    }\n\n                    .table_component caption {\n                        caption-side: top;\n                        text-align: left;\n                    }\n\n                    .table_component th {\n                        border: 1px solid #dededf;\n                        background-color: #c0bfbc;\n                        color: #000000;\n                        padding: 5px;\n                    }\n\n                    .table_component td {\n                        border: 1px solid #dededf;\n                        background-color: #ffffff;\n                        color: #000000;\n                        padding: 5px;\n                    }\n                    </style>\n                    <div class=\"table_component\" role=\"region\" tabindex=\"0\">\n                        <table>\n                            <caption>HTTP Server Information</caption>\n                            <thead>\n                                <tr>\n                                    <th>Status</th>\n                                    <th>Response Time (ms)</th>\n                                    <th>HTTP Server</th>\n                                    <th>HTTP Status</th>\n                                    <th>HTTP Status msg</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <tr>\n                                    <td><t t-out=\"object.status\"/></td>\n                                    <td><t t-out=\"object.response_time\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}\"/></td>\n                                    <td><t t-out=\"object.http_server\"/></td>\n                                    <td><t t-out=\"object.http_status\"/></td>\n                                    <td><t t-out=\"object.http_status_msg\"/></td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                    <t t-if=\"object.is_odoo and object.agent_enabled and object.agent_status == 'OK'\">\n                        <t t-if=\"object._resource_problems()\">\n                            <p><b>Server resources over their limit:</b></p>\n                            <ul>\n                                <li t-foreach=\"object._resource_problems()\" t-as=\"problem\"><t t-out=\"problem\"/></li>\n                            </ul>\n                        </t>\n                        <div class=\"table_component\" role=\"region\" tabindex=\"0\">\n                            <table>\n                                <caption>Server Resources</caption>\n                                <thead>\n                                    <tr>\n                                        <th>CPU (%)</th>\n                                        <th>Memory (%)</th>\n                                        <th>Storage (%)</th>\n                                        <th>Concurrent Requests</th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <tr>\n                                        <td><t t-out=\"object.cpu_percent\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 1}\"/></td>\n                                        <td><t t-out=\"object.memory_percent\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 1}\"/></td>\n                                        <td><t t-out=\"object.disk_percent\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 1}\"/></td>\n                                        <td><t t-out=\"object.requests_in_flight\"/></td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                    </t>\n                    <div class=\"table_component\" role=\"region\" tabindex=\"0\">\n                        <table>\n                            <caption>SSL Server Information</caption>\n                            <thead>\n                                <tr>\n                                    <th>SSL Status</th>\n                                    <th>SSL Issued By</th>\n                                    <th>SSL Until</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <tr>\n                                    <td><t t-out=\"object.ssl_status\"/></td>\n                                    <td><t t-out=\"object.ssl_issued_by\"/></td>\n                                    <td><t t-out=\"object.ssl_expiry_date\"/></td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n               </div>\n           "
msgstr "<div>\n                    <h2><b>¡Advertencia!</b></h2>\n                    <p>Tu servidor parece tener problemas. Debes revisarlo.</p>\n                    <p>Revisa tu servidor aquí: <a t-att-href=\"object.url\"><t t-out=\"object.url\"/></a></p>\n                    <p>Más información a continuación</p>\n                    <style>\n                    .table_component {\n                        overflow: auto;\n                        width: 100%;\n                    }\n\n                    .table_component table {\n                        border: 1px solid #dededf;\n                        height: 100%;\n                        width: 100%;\n                        table-layout: fixed;\n                        border-collapse: collapse;\n                        border-spacing: 1px;\n                        text-align: left;\n                    }\n\n                    .table_component caption {\n                        caption-side: top;\n                        text-align: left;\n                    }\n\n                    .table_component th {\n                        border: 1px solid #dededf;\n                        background-color: #c0bfbc;\n                        color: #000000;\n                        padding: 5px;\n                    }\n\n                    .table_component td {\n                        border: 1px solid #dededf;\n                        background-color: #ffffff;\n                        color: #000000;\n                        padding: 5px;\n                    }\n                    </style>\n                    <div class=\"table_component\" role=\"region\" tabindex=\"0\">\n                        <table>\n                            <caption>Información del servidor HTTP</caption>\n                            <thead>\n                                <tr>\n                                    <th>Estado</th>\n                                    <th>Tiempo de respuesta (ms)</th>\n                                    <th>Servidor HTTP</th>\n                                    <th>Estado HTTP</th>\n                                    <th>Mensaje de estado HTTP</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <tr>\n                                    <td><t t-out=\"object.status\"/></td>\n                                    <td><t t-out=\"object.response_time\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}\"/></td>\n                                    <td><t t-out=\"object.http_server\"/></td>\n                                    <td><t t-out=\"object.http_status\"/></td>\n                                    <td><t t-out=\"object.http_status_msg\"/></td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                    <t t-if=\"object.is_odoo and object.agent_enabled and object.agent_status == 'OK'\">\n                        <t t-if=\"object._resource_problems()\">\n                            <p><b>Recursos del servidor por encima de su límite:</b></p>\n                            <ul>\n                                <li t-foreach=\"object._resource_problems()\" t-as=\"problem\"><t t-out=\"problem\"/></li>\n                            </ul>\n                        </t>\n                        <div class=\"table_component\" role=\"region\" tabindex=\"0\">\n                            <table>\n                                <caption>Recursos del servidor</caption>\n                                <thead>\n                                    <tr>\n                                        <th>CPU (%)</th>\n                                        <th>Memoria (%)</th>\n                                        <th>Almacenamiento (%)</th>\n                                        <th>Peticiones concurrentes</th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <tr>\n                                        <td><t t-out=\"object.cpu_percent\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 1}\"/></td>\n                                        <td><t t-out=\"object.memory_percent\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 1}\"/></td>\n                                        <td><t t-out=\"object.disk_percent\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 1}\"/></td>\n                                        <td><t t-out=\"object.requests_in_flight\"/></td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                    </t>\n                    <div class=\"table_component\" role=\"region\" tabindex=\"0\">\n                        <table>\n                            <caption>Información SSL del servidor</caption>\n                            <thead>\n                                <tr>\n                                    <th>Estado SSL</th>\n                                    <th>SSL emitido por</th>\n                                    <th>SSL hasta</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <tr>\n                                    <td><t t-out=\"object.ssl_status\"/></td>\n                                    <td><t t-out=\"object.ssl_issued_by\"/></td>\n                                    <td><t t-out=\"object.ssl_expiry_date\"/></td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n               </div>\n           "

#. module: server_uptime_monitor
#: model:mail.template,body_html:server_uptime_monitor.email_monitor_expiry_template
msgid "<div>\n                   <h2><b>Expiry warning</b></h2>\n                   <p t-if=\"ctx.get('expiry_kind') == 'ssl_expiry'\">\n                       The SSL certificate of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.ssl_expiry_date\"/></b>\n                       (<t t-out=\"object.ssl_days_left\"/> days left).\n                   </p>\n                   <p t-else=\"\">\n                       The domain of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.domain_expiry_date\"/></b>\n                       (<t t-out=\"object.domain_days_left\"/> days left).\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <h2><b>Aviso de vencimiento</b></h2>\n                   <p t-if=\"ctx.get('expiry_kind') == 'ssl_expiry'\">\n                       El certificado SSL de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.ssl_expiry_date\"/></b>\n                       (<t t-out=\"object.ssl_days_left\"/> días restantes).\n                   </p>\n                   <p t-else=\"\">\n                       El dominio de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.domain_expiry_date\"/></b>\n                       (<t t-out=\"object.domain_days_left\"/> días restantes).\n                   </p>\n               </div>\n           "

#. module: server_uptime_monitor
#: model:mail.template,body_html:server_uptime_monitor.email_monitor_recovery_template
msgid "<div>\n                   <h2><b>Service recovered</b></h2>\n                   <p><t t-out=\"object.name\"/> (<a t-att-href=\"object.url\"><t t-out=\"object.url\"/></a>) is working again.</p>\n                   <p>Total downtime: <b><t t-out=\"object.last_downtime_minutes\"/></b> minutes.</p>\n                   <p>Current response time: <t t-out=\"object.response_time\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}\"/> ms.</p>\n               </div>\n           "
msgstr "<div>\n                   <h2><b>Servicio recuperado</b></h2>\n                   <p><t t-out=\"object.name\"/> (<a t-att-href=\"object.url\"><t t-out=\"object.url\"/></a>) funciona de nuevo.</p>\n                   <p>Tiempo total de caída: <b><t t-out=\"object.last_downtime_minutes\"/></b> minutos.</p>\n                   <p>Tiempo de respuesta actual: <t t-out=\"object.response_time\" t-options=\"{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}\"/> ms.</p>\n               </div>\n           "


msgid "Negative once the database has expired."
msgstr "Negativo cuando la base de datos ya venció."


#. module: server_uptime_monitor
#: model:mail.template,body_html:server_uptime_monitor.email_monitor_expiry_template
msgid "<div>\n                   <h2><b>Expiry warning</b></h2>\n                   <p t-if=\"ctx.get('expiry_kind') == 'ssl_expiry'\">\n                       The SSL certificate of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.ssl_expiry_date\"/></b>\n                       (<t t-out=\"object.ssl_days_left\"/> days left).\n                   </p>\n                   <p t-elif=\"ctx.get('expiry_kind') == 'db_expiry'\">\n                       The Odoo database of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.db_expiry_date\"/></b>\n                       (<t t-out=\"object.db_days_left\"/> days left).\n                       <t t-if=\"object.db_expiry_reason\">Type: <t t-out=\"object.db_expiry_reason\"/>.</t>\n                   </p>\n                   <p t-else=\"\">\n                       The domain of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.domain_expiry_date\"/></b>\n                       (<t t-out=\"object.domain_days_left\"/> days left).\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <h2><b>Aviso de vencimiento</b></h2>\n                   <p t-if=\"ctx.get('expiry_kind') == 'ssl_expiry'\">\n                       El certificado SSL de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.ssl_expiry_date\"/></b>\n                       (<t t-out=\"object.ssl_days_left\"/> días restantes).\n                   </p>\n                   <p t-elif=\"ctx.get('expiry_kind') == 'db_expiry'\">\n                       La base de datos Odoo de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.db_expiry_date\"/></b>\n                       (<t t-out=\"object.db_days_left\"/> días restantes).\n                       <t t-if=\"object.db_expiry_reason\">Tipo: <t t-out=\"object.db_expiry_reason\"/>.</t>\n                   </p>\n                   <p t-else=\"\">\n                       El dominio de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.domain_expiry_date\"/></b>\n                       (<t t-out=\"object.domain_days_left\"/> días restantes).\n                   </p>\n               </div>\n           "

#. module: server_uptime_monitor
#: model_terms:ir.ui.view,arch_db:server_uptime_monitor.website_monitor_view_form
msgid ""
"The server reports no expiration date for its database (Community edition or"
" not linked to a subscription yet)."
msgstr ""
"El servidor no informa fecha de vencimiento de su base de datos (edición "
"Community o aún sin vincular a una suscripción)."

#. module: server_uptime_monitor
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor__db_estimate_days
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor_resources_mixin__db_estimate_days
msgid "Estimate Expiry After (days)"
msgstr "Estimar vencimiento tras (días)"


#. module: server_uptime_monitor
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor__db_estimate_days
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor_resources_mixin__db_estimate_days
msgid "If the database reports no expiration date, assume it expires this many days after its creation, and warn accordingly. 0 disables the estimate."
msgstr "Si la base de datos no informa fecha de vencimiento, se supone que vence estos días después de su creación y se avisa en consecuencia. 0 desactiva la estimación."


#. module: server_uptime_monitor
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor__db_expiry_estimated
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor_resources_mixin__db_expiry_estimated
msgid "Estimated Expiry"
msgstr "Vencimiento estimado"


#. module: server_uptime_monitor
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor__db_expiry_estimated
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor_resources_mixin__db_expiry_estimated
msgid "The date is an estimate (creation date plus the configured days), not reported by the database."
msgstr "La fecha es una estimación (fecha de creación más los días configurados), no la informa la base de datos."


#. module: server_uptime_monitor
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor__db_create_date
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor_resources_mixin__db_create_date
msgid "Database Created"
msgstr "Base de datos creada"


#. module: server_uptime_monitor
#: model:mail.template,body_html:server_uptime_monitor.email_monitor_expiry_template
msgid "<div>\n                   <h2><b>Expiry warning</b></h2>\n                   <p t-if=\"ctx.get('expiry_kind') == 'ssl_expiry'\">\n                       The SSL certificate of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.ssl_expiry_date\"/></b>\n                       (<t t-out=\"object.ssl_days_left\"/> days left).\n                   </p>\n                   <p t-elif=\"ctx.get('expiry_kind') == 'db_expiry'\">\n                       The Odoo database of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.db_expiry_date\"/></b>\n                       (<t t-out=\"object.db_days_left\"/> days left).\n                       <t t-if=\"object.db_expiry_reason\">Type: <t t-out=\"object.db_expiry_reason\"/>.</t>\n                       <t t-if=\"object.db_expiry_estimated\">Estimated from the database creation date.</t>\n                   </p>\n                   <p t-else=\"\">\n                       The domain of <t t-out=\"object.name\"/> expires on\n                       <b><t t-out=\"object.domain_expiry_date\"/></b>\n                       (<t t-out=\"object.domain_days_left\"/> days left).\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <h2><b>Aviso de vencimiento</b></h2>\n                   <p t-if=\"ctx.get('expiry_kind') == 'ssl_expiry'\">\n                       El certificado SSL de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.ssl_expiry_date\"/></b>\n                       (<t t-out=\"object.ssl_days_left\"/> días restantes).\n                   </p>\n                   <p t-elif=\"ctx.get('expiry_kind') == 'db_expiry'\">\n                       La base de datos Odoo de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.db_expiry_date\"/></b>\n                       (<t t-out=\"object.db_days_left\"/> días restantes).\n                       <t t-if=\"object.db_expiry_reason\">Tipo: <t t-out=\"object.db_expiry_reason\"/>.</t>\n                       <t t-if=\"object.db_expiry_estimated\">Estimado a partir de la fecha de creación de la base de datos.</t>\n                   </p>\n                   <p t-else=\"\">\n                       El dominio de <t t-out=\"object.name\"/> vence el\n                       <b><t t-out=\"object.domain_expiry_date\"/></b>\n                       (<t t-out=\"object.domain_days_left\"/> días restantes).\n                   </p>\n               </div>\n           "

#. module: server_uptime_monitor
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor__db_alert_days
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor_resources_mixin__db_alert_days
msgid "Warn Database Expiry (days)"
msgstr "Avisar vencimiento de la base de datos (días)"

#. module: server_uptime_monitor
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor__expiry_alert_days
#: model:ir.model.fields,field_description:server_uptime_monitor.field_website_monitor_incident_mixin__expiry_alert_days
msgid "Warn SSL / Domain Expiry (days)"
msgstr "Avisar vencimiento de SSL / dominio (días)"

#. module: server_uptime_monitor
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor__db_alert_days
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor_resources_mixin__db_alert_days
msgid "Days before the Odoo database expires at which the group is warned, comma-separated (e.g. 30,15,7,5,1). One warning per level; add 1 to be warned again on the last day."
msgstr "Días antes de que venza la base de datos Odoo en los que se avisa al grupo, separados por comas (p. ej. 30,15,7,5,1). Un aviso por nivel; añada 1 para recibir otro el último día."

#. module: server_uptime_monitor
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor__expiry_alert_days
#: model:ir.model.fields,help:server_uptime_monitor.field_website_monitor_incident_mixin__expiry_alert_days
msgid "Days before the SSL certificate or the domain expires at which the group is warned, comma-separated (e.g. 30,15,7,1). One warning per level."
msgstr "Días antes de que venza el certificado SSL o el dominio en los que se avisa al grupo, separados por comas (p. ej. 30,15,7,1). Un aviso por nivel."

#. module: server_uptime_monitor
#. odoo-python
#: code:addons/server_uptime_monitor/models/monitor_incident.py:0
#: code:addons/server_uptime_monitor/models/monitor_resources.py:0
msgid "Warning days must be whole numbers separated by commas, e.g. 30,15,7,1."
msgstr "Los días de aviso deben ser números enteros separados por comas, p. ej. 30,15,7,1."

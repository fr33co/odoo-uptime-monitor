<odoo>
    <record id="module_category_website_monitor" model="ir.module.category">
        <field name="name">Website Monitor</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_website_monitor_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_website_monitor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view monitored websites and their history.</field>
    </record>

    <record id="group_website_monitor_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_website_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_website_monitor_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can configure websites, groups and contacts.</field>
    </record>
</odoo>

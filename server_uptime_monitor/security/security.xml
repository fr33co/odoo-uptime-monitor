<odoo>
    <record id="res_groups_privilege_website_monitor" model="res.groups.privilege">
        <field name="name">Website Monitor</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_website_monitor_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_website_monitor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view monitored websites and their history.</field>
    </record>

    <record id="group_website_monitor_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_website_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_website_monitor_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can configure websites, groups and contacts.</field>
    </record>
</odoo>

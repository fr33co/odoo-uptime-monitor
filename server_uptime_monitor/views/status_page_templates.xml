<odoo>
    <template id="status_page" name="Website Monitor Status Page">
        <t t-call="web.frontend_layout">
            <t t-set="title">Service Status</t>
            <div class="container py-5">
                <h1 class="mb-4">Service Status</h1>
                <div t-attf-class="alert #{'alert-success' if all_up else 'alert-danger'}">
                    <t t-if="all_up">All systems operational</t>
                    <t t-else="">Some services are experiencing problems</t>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Status</th>
                            <th class="text-end">Uptime (30 days)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="monitors" t-as="monitor" t-key="monitor.id">
                            <td t-out="monitor.name"/>
                            <td>
                                <span t-if="monitor.status == 'up'" class="badge text-bg-success">Operational</span>
                                <span t-elif="monitor.status == 'down'" class="badge text-bg-danger">Down</span>
                                <span t-else="" class="badge text-bg-secondary">Unknown</span>
                            </td>
                            <td class="text-end"><t t-out="'%.2f' % monitor.uptime_30d"/> %</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>

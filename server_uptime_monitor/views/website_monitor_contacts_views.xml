<odoo>
    <record id="website_monitor_contacts_view_list" model="ir.ui.view">
        <field name="name">website.monitor.contacts.list</field>
        <field name="model">website.monitor.contacts</field>
        <field name="arch" type="xml">
            <list>
                <field name="email"/>
                <field name="phone"/>
                <field name="notification_type"/>
                <field name="monitor_group_id"/>
            </list>
        </field>
    </record>

    <record id="website_monitor_contacts_view_form" model="ir.ui.view">
        <field name="name">website.monitor.contacts.form</field>
        <field name="model">website.monitor.contacts</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="notification_type"/>
                            <field name="email" invisible="notification_type != 'email'" required="notification_type == 'email'"/>
                            <field name="phone" invisible="notification_type != 'telegram'" required="notification_type == 'telegram'"/>
                        </group>
                        <group>
                            <field name="monitor_group_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_monitor_contacts_action" model="ir.actions.act_window">
        <field name="name">Website Monitor Contacts</field>
        <field name="res_model">website.monitor.contacts</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a contact</p>
        </field>
    </record>
</odoo>

<odoo>
    <record id="website_monitor_groups_view_list" model="ir.ui.view">
        <field name="name">website.monitor.groups.list</field>
        <field name="model">website.monitor.groups</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="website_monitor_groups_view_form" model="ir.ui.view">
        <field name="name">website.monitor.groups.form</field>
        <field name="model">website.monitor.groups</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="External Contacts" name="contacts">
                            <field name="contacts_ids">
                                <tree editable="bottom">
                                    <field name="notification_type"/>
                                    <field name="email" required="notification_type == 'email'" readonly="notification_type != 'email'"/>
                                    <field name="phone" required="notification_type == 'telegram'" readonly="notification_type != 'telegram'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_monitor_groups_action" model="ir.actions.act_window">
        <field name="name">Website Monitor Groups</field>
        <field name="res_model">website.monitor.groups</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a notification group</p>
        </field>
    </record>
</odoo>

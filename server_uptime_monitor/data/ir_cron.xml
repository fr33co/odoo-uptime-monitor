<odoo>
    <record id="ir_cron_check_website_monitor_cron" model="ir.cron">
        <field name="name">Website Monitor: check websites</field>
        <field name="model_id" ref="model_website_monitor"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_websites()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
